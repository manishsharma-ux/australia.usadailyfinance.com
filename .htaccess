# ============================================================================
# Hostinger deploys this whole repo straight into public_html, so every file
# in it is on the web. The pages live in their own folders (solar1/ is served
# at /solar1/). Everything else here — setup notes, the Apps Script source,
# tooling and old backups — is for us, not for visitors, so refuse it.
#
# solar1/.htaccess holds the caching rules for the site itself.
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Notes, Apps Script source, scripts and editor backups, in any folder.
    RewriteRule \.(md|py|gs|save)$ - [F,L]
    RewriteRule \.backup\.[a-z]+$ - [F,L]

    # Top-level folders and files that are not part of any page.
    RewriteRule ^(google-apps-script|\.agents|bmw-m|claude|vercel)(/|$) - [F,L]
    RewriteRule ^skills-lock\.json$ - [F,L]
</IfModule>
